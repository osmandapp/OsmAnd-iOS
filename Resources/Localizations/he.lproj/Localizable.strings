//inapps
"plugin_nautical_name" = "תצוגת מפה ימית";
"plugin_nautical_descr" = "תוסף זה מעשיר את המפה ואת הניווט של יישומון OsmAnd ומאפשר לייצר מפות ימיות לחתירה, הפלגה וסוגים נוספים של ספורט ימי. \n \nתוסף מפה מיוחד ל־OsmAnd יספק את כל סימוני הניווט הימיים והסימנים הימיים המוסכמים, לניווט במקווי מים פנימיים לרבות ניווט באזורים הקרובים לחוף. התיאור של כל סימון ניווט מספק את הפרטים הנדרשים כדי לזהות אותם ואת המשמעות שלהם (קטגוריה, צורה, צבע, רצף, הפניה וכו׳). \n \nכדי לחזור לאחד מסגנונות המפה הרגילים של OsmAnd עליך פשוט להשבית את התוסף הזה שוב או לשנות את ‚סגנון המפה’ תחת ‚הגדרות המפה’ לפי הצורך.";
"osmand_parking_plugin_name" = "מיקום החנייה";
"osmand_parking_plugin_description" = "מאפשר לך לשמור איפה רכבך חנה וכמה זמן נותר לחנייה. \n המיקום והשעה מופיעים בלוח הבקרה וגם בחלונית מפה. ניתן להוסיף התראה ליומן של Android.";
"plugin_ski_name" = "תצוגת מפת סקי";
"plugin_ski_descr" = "תוסף זה ל־OsmAnd מגיש לך פרטים של מדרוני גלישת סקי, מסלולי סקי חוצי מדינות, מסלולי סקי אלפינים, רכבלים ומעליות סקי. המעברים והמסלולים מופיעים בצבע לפי דרגת קושי ומופיעים בסגנון מפה מיוחד בשם ‚חורף’ שמטמיע משטחי חורף בצבעי שלג. \n \nהפעלת תצוגה זו משנה את סגנון המפה ל‚חורף וסקי’ והיא מפעילה את כל תכונות הקרקע בתנאי חורף. ניתן לכבות תצוגה זו על ידי השבתתה כאן או על ידי שינוי ‚סגנון המפה’ תחת ‚הגדרת המפה’ לפי הצורך.";
"record_plugin_name" = "הקלטת מסלול";
"record_plugin_description" = "תוסף זה מפעיל את התכונה להקלטת ולשמירת המסלולים שלך על ידי נגיעה באופן ידני בווידג׳ט רישום ה־GPX במפה, או גם לערוך רישום של כל נתיבי הניווט שלך לקובץ GPX. \n  \nניתן לשתף נתיבים מוקלטים עם חבריך או להשתמש בהם כתרומה ל־OSM. אתלטים יכולים להשתמש במסלולים מוקלטים כדי לעקוב אחר האימונים שלהם. ניתן לבצע ניתוח מסלול בסיסי ישירות ב־OsmAnd, כמו זמני הקפה, מהירות ממוצעת וכו׳, כמו כן, ניתן לנתח את המסלולים בשלב מאוחר יותר על ידי כלי ניתוח מיוחדים מגורמי צד־שלישי.";
"osm_editing_plugin_name" = "עריכה של OpenStreetMap";
"osm_editing_plugin_description" = "אפשר לתרום ל־OpenStreetMap קהילה בינלאומית שמתחזקת מפה מפורטת של העולם ומספקת נתונים עדכניים בקוד פתוח לכל המשתמשים.\n\nאפשר למצוא הנחיות איך לערוך את המפה באתר שלנו %@.";
"plugin_mapillary_descr" = "תמונות ברמת הרחוב לכולם. להכיר מקומות, לשתף פעולה ולצלם את העולם.";
"download_wikipedia_maps" = "ויקיפדיה";
"purchases_feature_desc_wikipedia" = "מספק את כל ערכי ויקיפדיה הקשורים למקומות במצב לא מקוון, כדי לעזור לך ללמוד על המקומות שבהם אתה מבקר בטיול בנגיעה פשוטה במפה. לא לשכוח להוריד את קובצי מפות ויקיפדיה לאזורים הרלוונטיים.";
"shared_string_all_languages" = "כל השפות";
"select_wikipedia_article_langs" = "נא לבחור את השפות לערכים של ויקיפדיה במפה. ניתן להחליף לכל אחת מהשפות הזמינות בזמן קריאת הערך.";
"wiki_menu_download_descr" = "נדרשות מפות נוספות כדי לצפות בנקודות עניין של ויקיפדיה במפה.";
