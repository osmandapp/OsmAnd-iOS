		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%2$@ ٹریک</string>
			<key>other</key>
			<string>%2$@ ٹریک</string>
		</dict>
	</dict>
	<key>osm_edits_delete_items_confirmation</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@edits@</string>
		<key>edits</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>کیا آپ واقعی %2$@ ترمیم حذف کرنا چاہتے ہیں؟</string>
			<key>other</key>
			<string>کیا آپ واقعی %2$@ ترامیم حذف کرنا چاہتے ہیں؟</string>
		</dict>
	</dict>
