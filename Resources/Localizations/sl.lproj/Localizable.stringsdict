<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>favorites_delete_confirmation_title</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Izbriši %1$#@favorites@?</string>
		<key>favorites</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%2$@ priljubljeno</string>
			<key>two</key>
			<string>%2$@ priljubljeni</string>
			<key>few</key>
			<string>%2$@ priljubljene</string>
			<key>other</key>
			<string>%2$@ priljubljenih</string>
		</dict>
	</dict>
	<key>folders_delete_confirmation_title</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Izbriši %1$#@folders@?</string>
		<key>folders</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%2$@ mapo</string>
			<key>two</key>
			<string>%2$@ mapi</string>
			<key>few</key>
			<string>%2$@ mape</string>
			<key>other</key>
			<string>%2$@ map</string>
		</dict>
	</dict>
	<key>folders_favorites_delete_message</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Izbriši %1$#@folders@ in %3$#@points@. Tega dejanja ni mogoče preklicati.</string>
		<key>folders</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%2$@ mapo</string>
			<key>two</key>
			<string>%2$@ mapi</string>
			<key>few</key>
			<string>%2$@ mape</string>
			<key>other</key>
			<string>%2$@ map</string>
		</dict>
		<key>points</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%4$@ točko</string>
			<key>two</key>
			<string>%4$@ točki</string>
			<key>few</key>
			<string>%4$@ točke</string>
			<key>other</key>
			<string>%4$@ točk</string>
		</dict>
	</dict>
	<key>carplay_trip_via_stops</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Via %#@stops@</string>
		<key>stops</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld postaja</string>
			<key>two</key>
			<string>%ld postaji</string>
			<key>few</key>
			<string>%ld postaje</string>
			<key>other</key>
			<string>%ld postaj</string>
		</dict>
	</dict>
</dict>
</plist>
