<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>favorites_delete_confirmation_title</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Borrar %1$#@favorites@?</string>
		<key>favorites</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%2$@ Favorito</string>
			<key>many</key>
			<string>%2$@ Favoritos</string>
			<key>other</key>
			<string>%2$@ Favoritos</string>
		</dict>
	</dict>
	<key>folders_delete_confirmation_title</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Borrar %1$#@folders@?</string>
		<key>folders</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%2$@ Carpeta</string>
			<key>many</key>
			<string>%2$@ carpetas</string>
			<key>other</key>
			<string>%2$@ carpetas</string>
		</dict>
	</dict>
	<key>folders_favorites_delete_message</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Borrar %1$#@folders@ y %3$#@points@. Esta acción no se puede deshacer.</string>
		<key>folders</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%2$@ Carpeta</string>
			<key>many</key>
			<string>%2$@ carpetas</string>
			<key>other</key>
			<string>%2$@ carpetas</string>
		</dict>
		<key>points</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%4$@ Punto</string>
			<key>many</key>
			<string>%4$@ Puntos</string>
			<key>other</key>
			<string>%4$@ Puntos</string>
		</dict>
	</dict>
	<key>carplay_trip_via_stops</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Vía %#@stops@</string>
		<key>stops</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld parada</string>
			<key>other</key>
			<string>%ld paradas</string>
		</dict>
	</dict>
	<key>folder_tracks_count</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@tracks@</string>
		<key>tracks</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%2$@ pista</string>
			<key>many</key>
			<string>%2$@ pistas</string>
