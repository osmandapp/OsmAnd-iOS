<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>favorites_delete_confirmation_title</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Видалити %1$#@favorites@?</string>
		<key>favorites</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%2$@ закладку</string>
			<key>few</key>
			<string>%2$@ закладки</string>
			<key>many</key>
			<string>%2$@ закладок</string>
			<key>other</key>
			<string>%2$@ закладки</string>
		</dict>
	</dict>
	<key>folders_delete_confirmation_title</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Видалити %1$#@folders@?</string>
		<key>folders</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%2$@ папку</string>
			<key>few</key>
			<string>%2$@ папки</string>
			<key>many</key>
			<string>%2$@ папок</string>
			<key>other</key>
			<string>%2$@ папки</string>
		</dict>
	</dict>
	<key>folders_favorites_delete_message</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Видалити %1$#@folders@ та %3$#@points@. Цю дію не можна скасувати.</string>
		<key>folders</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%2$@ папку</string>
			<key>few</key>
			<string>%2$@ папки</string>
			<key>many</key>
			<string>%2$@ папок</string>
			<key>other</key>
			<string>%2$@ папки</string>
		</dict>
		<key>points</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%4$@ точку</string>
			<key>few</key>
			<string>%4$@ точки</string>
			<key>many</key>
			<string>%4$@ точок</string>
			<key>other</key>
			<string>%4$@ точки</string>
		</dict>
	</dict>
    <key>carplay_trip_via_stops</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>Через %#@stops@</string>
        <key>stops</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>ld</string>
            <key>one</key>
            <string>%ld зупинку</string>
            <key>few</key>
            <string>%ld зупинки</string>
            <key>many</key>
            <string>%ld зупинок</string>
            <key>other</key>
            <string>%ld зупинок</string>
        </dict>
    </dict>
</dict>
</plist>
