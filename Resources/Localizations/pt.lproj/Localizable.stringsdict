		<key>edits</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>Are you sure you want to delete %2$@ edit?</string>
			<key>many</key>
			<string>Are you sure you want to delete %2$@ edits?</string>
			<key>other</key>
