			<key>many</key>
			<string>%ld مجلدا</string>
			<key>other</key>
			<string>%ld مجلد</string>
		</dict>
	</dict>
	<key>folders_favorites_delete_message</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>حذف %#@folders@ و %#@points@. لا يمكن التراجع عن هذا الإجراء.</string>
		<key>folders</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>zero</key>
			<string>%ld مجلدات</string>
			<key>one</key>
			<string>%ld مجلد</string>
			<key>two</key>
			<string>%ld مجلدان</string>
			<key>few</key>
			<string>%ld مجلدات</string>
			<key>many</key>
			<string>%ld مجلدا</string>
			<key>other</key>
			<string>%ld مجلد</string>
		</dict>
		<key>points</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>zero</key>
			<string>%ld نقاط</string>
			<key>one</key>
			<string>%ld نقطة</string>
