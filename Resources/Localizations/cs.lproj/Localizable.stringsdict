<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>favorites_delete_confirmation_title</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Vymazat %#@favorites@?</string>
		<key>favorites</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld oblíbenou položku</string>
			<key>few</key>
			<string>%ld oblíbené položky</string>
			<key>many</key>
			<string>%ld oblíbených položek</string>
			<key>other</key>
			<string>%ld oblíbené položky</string>
		</dict>
	</dict>
	<key>folders_delete_confirmation_title</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Vymazat %#@folders@?</string>
		<key>folders</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld složku</string>
			<key>few</key>
			<string>%ld složky</string>
			<key>many</key>
			<string>%ld složek</string>
			<key>other</key>
			<string>%ld složky</string>
		</dict>
	</dict>
	<key>folders_favorites_delete_message</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Vymazat %#@folders@ a %#@points@. Tuto akci nelze vrátit zpět.</string>
		<key>folders</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld složku</string>
			<key>few</key>
			<string>%ld složky</string>
			<key>many</key>
			<string>%ld složek</string>
			<key>other</key>
			<string>%ld složky</string>
		</dict>
		<key>points</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld bod</string>
			<key>few</key>
			<string>%ld body</string>
			<key>many</key>
			<string>%ld bodů</string>
			<key>other</key>
			<string>%ld bodu</string>
		</dict>
	</dict>
</dict>
</plist>
