			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%4$@ ബിന്ദൂ(പോയിന്റ്)</string>
			<key>other</key>
			<string>%4$@ പോയിന്റുകള്‍</string>
