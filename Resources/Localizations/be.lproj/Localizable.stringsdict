<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>favorites_delete_confirmation_title</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Выдаліць %1$#@favorites@?</string>
		<key>favorites</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%2$@ абраную кропку</string>
			<key>few</key>
			<string>%2$@ абраныя кропкі</string>
			<key>many</key>
			<string>%2$@ абраных кропак</string>
			<key>other</key>
			<string>%2$@ абраных кропак</string>
		</dict>
	</dict>
	<key>folders_delete_confirmation_title</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Выдаліць %1$#@folders@?</string>
		<key>folders</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%2$@ папку</string>
			<key>few</key>
			<string>%2$@ папкі</string>
			<key>many</key>
			<string>%2$@ папак</string>
			<key>other</key>
			<string>%2$@ папак</string>
		</dict>
	</dict>
	<key>folders_favorites_delete_message</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Выдаліць %1$#@folders@ і %3$#@points@. Гэта дзеянне нельга скасаваць.</string>
		<key>folders</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%2$@ папку</string>
			<key>few</key>
			<string>%2$@ папкі</string>
			<key>many</key>
			<string>%2$@ папак</string>
			<key>other</key>
			<string>%2$@ папак</string>
		</dict>
		<key>points</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%4$@ кропку</string>
			<key>few</key>
			<string>%4$@ кропкі</string>
			<key>many</key>
			<string>%4$@ кропак</string>
			<key>other</key>
			<string>%4$@ кропак</string>
		</dict>
	</dict>
	<key>carplay_trip_via_stops</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Праз %#@stops@</string>
		<key>stops</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld прыпынак</string>
			<key>few</key>
			<string>%ld прыпынкі</string>
			<key>many</key>
			<string>%ld прыпынкаў</string>
			<key>other</key>
			<string>%ld прыпынка</string>
		</dict>
	</dict>
</dict>
</plist>
