<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>favorites_delete_confirmation_title</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>删除 %#@favorites@?</string>
		<key>favorites</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>other</key>
			<string>%ld 收藏</string>
		</dict>
	</dict>
	<key>folders_delete_confirmation_title</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>删除 %#@folders@?</string>
		<key>folders</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>other</key>
			<string>%ld 文件夹</string>
		</dict>
	</dict>
	<key>folders_favorites_delete_message</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>删除 %#@folders@ 与 %#@points@. 此操作将无法撤销。</string>
		<key>folders</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>other</key>
			<string>%ld 文件夹</string>
		</dict>
		<key>points</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>other</key>
			<string>%ld 点</string>
		</dict>
	</dict>
	<key>carplay_trip_via_stops</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>途经 %#@stops@</string>
		<key>stops</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>other</key>
			<string>%ld 站</string>
		</dict>
