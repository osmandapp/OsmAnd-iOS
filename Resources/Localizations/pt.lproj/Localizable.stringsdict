			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>Number of separate tracks in the file %2$@: %3$@. Select the tracks you want to import.</string>
			<key>many</key>
			<string>Number of separate tracks in the file %2$@: %3$@. Select the tracks you want to import.</string>
			<key>other</key>
