	</dict>
	<key>folders_favorites_delete_message</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Delete %1$#@folders@ and %3$#@points@. This action cannot be undone.</string>
		<key>folders</key>
