<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>items_delete_confirmation_title</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@items@ مٹاؤ؟</string>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%2$@ آئٹم</string>
			<key>other</key>
			<string>%2$@ آئٹم</string>
		</dict>
	</dict>
	<key>favorites_delete_confirmation_title</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Delete %1$#@favorites@?</string>
		<key>favorites</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%2$@ Favorite</string>
			<key>other</key>
			<string>%2$@ Favorites</string>
		</dict>
	</dict>
	<key>folders_delete_confirmation_title</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Delete %1$#@folders@?</string>
		<key>folders</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%2$@ Folder</string>
			<key>other</key>
			<string>%2$@ Folder</string>
		</dict>
	</dict>
	<key>folders_favorites_delete_message</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Delete %1$#@folders@ and %3$#@points@. This action cannot be undone.</string>
		<key>folders</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%2$@ Folder</string>
			<key>other</key>
			<string>%2$@ Folder</string>
		</dict>
		<key>points</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%4$@ Point</string>
			<key>other</key>
			<string>%4$@ Points</string>
		</dict>
	</dict>
	<key>carplay_trip_via_stops</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Via %#@stops@</string>
		<key>stops</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld اسٹاپ</string>
			<key>other</key>
			<string>%ld اسٹاپ</string>
		</dict>
	</dict>
	<key>folder_tracks_count</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@tracks@</string>
		<key>tracks</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%2$@ ٹریک</string>
			<key>other</key>
			<string>%2$@ ٹریک</string>
		</dict>
	</dict>
	<key>osm_edits_delete_items_confirmation</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@edits@</string>
		<key>edits</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>کیا تسیں %2$@ تبدیلی مٹانا چاہندے او؟</string>
			<key>other</key>
			<string>کیا تسیں %2$@ تبدیلیاں مٹانا چاہندے او؟</string>
		</dict>
	</dict>
	<key>selected_items_count</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@items@</string>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%2$@ آئٹم</string>
			<key>other</key>
			<string>%2$@ آئٹم</string>
		</dict>
	</dict>
	<key>import_tracks_description</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@tracks@</string>
		<key>tracks</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%2$@ فائل وچ %3$@ وکھرا ٹریک اے۔ جیہڑا تسیں امپورٹ کرنا چاہندے او اوہ چُنو۔</string>
			<key>other</key>
			<string>%2$@ فائل وچ %3$@ وکھرے ٹریک نیں۔ جیہڑے تسیں امپورٹ کرنا چاہندے او اوہ چُنو۔</string>
		</dict>
	</dict>
</dict>
</plist>
