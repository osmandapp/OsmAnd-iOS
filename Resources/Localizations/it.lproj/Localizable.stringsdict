	</dict>
	<key>folders_favorites_delete_message</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Elimina %1$#@folders@ e %3$#@points@. Questa azione non può essere annullata.</string>
		<key>folders</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%2$@ Cartella</string>
			<key>many</key>
			<string>%2$@ Cartelle</string>
			<key>other</key>
			<string>%2$@ Cartelle</string>
		</dict>
