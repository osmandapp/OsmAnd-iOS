			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>Il file %2$@ contiene %3$@ traccia separata. Seleziona quella da importare.</string>
			<key>many</key>
			<string>Il file %2$@ contiene %3$@ tracce separate. Seleziona quelle da importare.</string>
			<key>other</key>
