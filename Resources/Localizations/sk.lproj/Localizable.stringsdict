<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>favorites_delete_confirmation_title</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Odstrániť %#@favorites@?</string>
		<key>favorites</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld obľúbenú položku</string>
			<key>few</key>
			<string>%ld obľúbené položky</string>
			<key>many</key>
			<string>%ld obľúbených položiek</string>
			<key>other</key>
			<string>%ld obľúbenej položky</string>
		</dict>
	</dict>
	<key>folders_delete_confirmation_title</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Odstrániť %#@folders@?</string>
		<key>folders</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld priečinok</string>
			<key>few</key>
			<string>%ld priečinky</string>
			<key>many</key>
			<string>%ld priečinkov</string>
			<key>other</key>
			<string>%ld priečinka</string>
		</dict>
	</dict>
	<key>folders_favorites_delete_message</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Odstrániť %#@folders@ a %#@points@. Táto akcia sa nedá odvolať.</string>
		<key>folders</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld priečinok</string>
			<key>few</key>
			<string>%ld priečinky</string>
			<key>many</key>
			<string>%ld priečinkov</string>
			<key>other</key>
			<string>%ld priečinka</string>
		</dict>
		<key>points</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld bod</string>
			<key>few</key>
			<string>%ld body</string>
			<key>many</key>
			<string>%ld bodov</string>
			<key>other</key>
			<string>%ld bodu</string>
		</dict>
	</dict>
</dict>
</plist>
