		</dict>
	</dict>
	<key>folders_favorites_delete_message</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Hapus %1$#@folders@ dan %3$#@points@. Tindakan ini tidak bisa dibatalkan.</string>
