<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>items_delete_confirmation_title</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@items@ মুছে ফেলবেন?</string>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%2$@ আইটেম</string>
			<key>other</key>
			<string>%2$@ আইটেম</string>
		</dict>
	</dict>
	<key>favorites_delete_confirmation_title</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Delete %1$#@favorites@?</string>
		<key>favorites</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%2$@ favorite</string>
			<key>other</key>
			<string>%2$@ favorites</string>
		</dict>
	</dict>
	<key>folders_delete_confirmation_title</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Delete %1$#@folders@?</string>
		<key>folders</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%2$@ folder</string>
			<key>other</key>
			<string>%2$@ folder</string>
		</dict>
	</dict>
	<key>folders_favorites_delete_message</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Delete %1$#@folders@ and %3$#@points@. This action cannot be undone.</string>
		<key>folders</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%2$@ folder</string>
			<key>other</key>
			<string>%2$@ folder</string>
		</dict>
		<key>points</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%4$@ point</string>
			<key>other</key>
			<string>%4$@ points</string>
		</dict>
	</dict>
	<key>carplay_trip_via_stops</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Via %#@stops@</string>
		<key>stops</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld স্টপ</string>
			<key>other</key>
			<string>%ld স্টপ</string>
		</dict>
	</dict>
	<key>folder_tracks_count</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@tracks@</string>
		<key>tracks</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%2$@ ট্র্যাক</string>
			<key>other</key>
			<string>%2$@ ট্র্যাক</string>
		</dict>
	</dict>
	<key>osm_edits_delete_items_confirmation</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@edits@</string>
		<key>edits</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>আপনি কি নিশ্চিতভাবে %2$@ সম্পাদনা মুছে ফেলতে চান?</string>
			<key>other</key>
			<string>আপনি কি নিশ্চিতভাবে %2$@ সম্পাদনা মুছে ফেলতে চান?</string>
		</dict>
	</dict>
	<key>selected_items_count</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@items@</string>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%2$@ আইটেম</string>
			<key>other</key>
			<string>%2$@ আইটেম</string>
		</dict>
	</dict>
	<key>import_tracks_description</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@tracks@</string>
		<key>tracks</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%2$@ ফাইলে %3$@ টি পৃথক ট্র্যাক আছে। আমদানি করতে চান এমন ট্র্যাক নির্বাচন করুন।</string>
			<key>other</key>
			<string>%2$@ ফাইলে %3$@ টি পৃথক ট্র্যাক আছে। আমদানি করতে চান এমন ট্র্যাক নির্বাচন করুন।</string>
		</dict>
	</dict>
</dict>
</plist>
