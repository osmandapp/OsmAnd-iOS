<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>favorites_delete_confirmation_title</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Удалить %#@favorites@?</string>
		<key>favorites</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld избранную точку</string>
			<key>few</key>
			<string>%ld избранные точки</string>
			<key>many</key>
			<string>%ld избранных точек</string>
			<key>other</key>
			<string>%ld избранных точек</string>
		</dict>
	</dict>
	<key>folders_delete_confirmation_title</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Удалить %#@folders@?</string>
		<key>folders</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld папку</string>
			<key>few</key>
			<string>%ld папки</string>
			<key>many</key>
			<string>%ld папок</string>
			<key>other</key>
			<string>%ld папок</string>
		</dict>
	</dict>
	<key>folders_favorites_delete_message</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Удалить %#@folders@ и %#@points@. Это действие нельзя будет отменить.</string>
		<key>folders</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld папку</string>
			<key>few</key>
			<string>%ld папки</string>
			<key>many</key>
			<string>%ld папок</string>
			<key>other</key>
			<string>%ld папок</string>
		</dict>
		<key>points</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld точку</string>
			<key>few</key>
			<string>%ld точки</string>
			<key>many</key>
			<string>%ld точек</string>
			<key>other</key>
			<string>%ld точек</string>
		</dict>
	</dict>
</dict>
</plist>
