<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>favorites_delete_confirmation_title</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>삭제 %1$#@favorites@?</string>
		<key>favorites</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>other</key>
			<string>%2$@ 즐겨찾기</string>
		</dict>
	</dict>
	<key>folders_delete_confirmation_title</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>삭제 %1$#@folders@?</string>
		<key>folders</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>other</key>
			<string>%2$@ 폴더</string>
		</dict>
	</dict>
	<key>folders_favorites_delete_message</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>삭제 %1$#@folders@ 그리고 %3$#@points@. 이 작업은 취소할 수 없습니다.</string>
		<key>folders</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>other</key>
			<string>%2$@ 폴더</string>
		</dict>
		<key>points</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>other</key>
			<string>%4$@ 장소</string>
		</dict>
	</dict>
	<key>carplay_trip_via_stops</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>경유 %#@stops@</string>
		<key>stops</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>other</key>
			<string>%ld 정류장</string>
		</dict>
	</dict>
	<key>folder_tracks_count</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@tracks@</string>
		<key>tracks</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>other</key>
			<string>%2$@ 트랙</string>
		</dict>
	</dict>
	<key>osm_edits_delete_items_confirmation</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@edits@</string>
		<key>edits</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>other</key>
			<string>Are you sure you want to delete %2$@ edits?</string>
		</dict>
	</dict>
	<key>selected_items_count</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@items@</string>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>other</key>
			<string>%2$@ 항목</string>
		</dict>
	</dict>
</dict>
</plist>
