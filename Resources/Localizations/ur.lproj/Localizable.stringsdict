	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@tracks@</string>
		<key>tracks</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>فائل %2$@ میں %3$@ الگ ٹریک ہے۔ جو آپ درآمد کرنا چاہتے ہیں اسے منتخب کریں۔</string>
			<key>other</key>
			<string>فائل %2$@ میں %3$@ الگ ٹریک ہیں۔ جو آپ درآمد کرنا چاہتے ہیں انہیں منتخب کریں۔</string>
		</dict>
	</dict>
