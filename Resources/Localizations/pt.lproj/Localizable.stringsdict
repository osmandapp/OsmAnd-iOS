		</dict>
	</dict>
	<key>folders_favorites_delete_message</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Eliminar %1$#@folders@ e %3$#@points@. Esta ação não pode ser desfeita.</string>
		<key>folders</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%2$@ Pasta</string>
			<key>many</key>
			<string>%2$@ pastas</string>
			<key>other</key>
			<string>%2$@ pastas</string>
		</dict>
