		<key>NSStringLocalizedFormatKey</key>
		<string>Выдаліць %#@favorites@?</string>
		<key>favorites</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld абраную кропку</string>
			<key>few</key>
			<string>%ld абраныя кропкі</string>
