<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>favorites_delete_confirmation_title</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Vymazat %1$#@favorites@?</string>
		<key>favorites</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%2$@ oblíbenou položku</string>
			<key>few</key>
			<string>%2$@ oblíbené položky</string>
			<key>many</key>
			<string>%2$@ oblíbených položek</string>
			<key>other</key>
			<string>%2$@ oblíbené položky</string>
		</dict>
	</dict>
	<key>folders_delete_confirmation_title</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Vymazat %1$#@folders@?</string>
		<key>folders</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%2$@ složku</string>
			<key>few</key>
			<string>%2$@ složky</string>
			<key>many</key>
			<string>%2$@ složek</string>
			<key>other</key>
			<string>%2$@ složky</string>
		</dict>
	</dict>
	<key>folders_favorites_delete_message</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Vymazat %1$#@folders@ a %3$#@points@. Tuto akci nelze vrátit zpět.</string>
		<key>folders</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%2$@ složku</string>
			<key>few</key>
			<string>%2$@ složky</string>
			<key>many</key>
			<string>%2$@ složek</string>
			<key>other</key>
			<string>%2$@ složky</string>
		</dict>
		<key>points</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%4$@ bod</string>
			<key>few</key>
			<string>%4$@ body</string>
			<key>many</key>
			<string>%4$@ bodů</string>
			<key>other</key>
			<string>%4$@ bodu</string>
		</dict>
	</dict>
	<key>carplay_trip_via_stops</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Přes %#@stops@</string>
		<key>stops</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld zastávka</string>
			<key>few</key>
			<string>%ld zastávky</string>
			<key>many</key>
			<string>%ld zastávky</string>
			<key>other</key>
			<string>%ld zastávek</string>
		</dict>
	</dict>
	<key>folder_tracks_count</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@tracks@</string>
		<key>tracks</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%2$@ stopa</string>
			<key>few</key>
			<string>%2$@ stopy</string>
			<key>many</key>
			<string>%2$@ stop</string>
			<key>other</key>
			<string>%2$@ stop</string>
		</dict>
	</dict>
</dict>
</plist>
