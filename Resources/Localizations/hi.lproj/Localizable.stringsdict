			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%2$@ फ़ाइल में %3$@ अलग ट्रैक है। जिसे आप आयात करना चाहते हैं उसे चुनें।</string>
			<key>other</key>
			<string>%2$@ फ़ाइल में %3$@ अलग ट्रैक हैं। जिन्हें आप आयात करना चाहते हैं उन्हें चुनें।</string>
		</dict>
